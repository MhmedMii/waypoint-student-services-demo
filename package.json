    "next": "^15.5.27",
    "next-auth": "^4.24.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
